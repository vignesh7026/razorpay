# Copy this file to .env and fill in Razorpay TEST-MODE credentials to use
# RealRazorpayClient. Leave blank / omit .env entirely to run fully on
# SimulatedRazorpayClient (see app/razorpay_client.py).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Rupee threshold above which a prior-failed transaction is mandatorily
# escalated to a human (SR5). See PRD section 14 open questions.
ESCALATION_AMOUNT_THRESHOLD_INR=5000
